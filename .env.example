# ─── Flask ─────────────────────────────
FLASK_ENV=development
FLASK_APP=run:app
SECRET_KEY=troque-por-uma-chave-aleatoria

# ─── Banco de dados (NeonDB / Postgres) ─
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Google / GCP ──────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/caminho/absoluto/service-account.json
GCP_PROJECT_ID=meu-projeto
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Git ───────────────────────────────
GIT_TOKEN=
GIT_WEBHOOK_SECRET=
